AQUEDUCT_API_KEY=
AQUEDUCT_API_KEY_FILE=

# Optional local cross-encoder cache; defaults to ~/.cache/rag-eval/models.
RAG_EVAL_MODEL_CACHE_DIR=

API_HOST=127.0.0.1
API_PORT=8002

# Docker Compose uses the POSTGRES_* values; DATABASE_URL is used by the host CLI.
POSTGRES_DB=llm_grounding
POSTGRES_USER=llm_grounding
POSTGRES_PASSWORD=llm_grounding_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://llm_grounding:llm_grounding_dev@localhost:5432/llm_grounding

# Qdrant is a rebuildable, versioned vector index; use no API key for local Compose.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=llm_grounding_v1

# MINIO_ENDPOINT deliberately has no URL scheme: it is consumed by minio-py.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=llm-grounding-documents
MINIO_SECURE=false
